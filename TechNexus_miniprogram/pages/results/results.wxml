<view class="page">
  <view class="hero-shell compact">
    <image class="hero-image" src="/assets/jiangsu_industrial_workshop.jpg" mode="aspectFill" />
    <view class="hero-mask"></view>
    <view class="hero-content">
      <view>
        <text class="eyebrow">{{modeTitle}}</text>
        <view class="hero-main">
          <text class="hero-title">返回 5 条以内候选需求，只展示能判断合作价值的信息</text>
          <text class="hero-copy">{{modeCopy}} 平台前台不展示需求方联系方式；如需继续推进，请提交合作意向进入后台人工撮合。</text>
        </view>
      </view>
      <view class="hero-kpis">
        <view class="hero-kpi">
          <strong>{{resultCountText}}</strong>
          <span>本次返回候选数</span>
        </view>
        <view class="hero-kpi">
          <strong>100</strong>
          <span>匹配评分总分</span>
        </view>
        <view class="hero-kpi">
          <strong>隐藏</strong>
          <span>需求方联系方式</span>
        </view>
        <view class="hero-kpi">
          <strong>3日</strong>
          <span>初步反馈承诺</span>
        </view>
      </view>
    </view>
  </view>

  <view class="band">
    <view class="band-header">
      <text class="section-title">{{modeTitle}}</text>
      <text class="muted">最多展示 5 条需求，只展示匹配分、理由和合作建议，不展示需求方联系方式。</text>
    </view>
    <view class="actions">
      <button class="btn ghost" bindtap="goSubmit">修改成果</button>
    </view>
  </view>

  <view wx:if="{{!results.length}}" class="empty">暂无匹配结果。请先提交技术成果，系统会返回最适合撮合的技术需求。</view>

  <view wx:for="{{results}}" wx:key="index" wx:for-index="rank" class="result-card {{item.level}}">
    <view class="result-rank">TOP {{rank + 1}}</view>
    <view class="result-head">
      <view class="result-name">{{item.name}}</view>
      <view class="score">
        <text>{{item.score}}%</text>
        <text class="score-caption">{{item.score_label}}</text>
      </view>
    </view>
    <view class="tags">
      <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
    </view>
    <view wx:for="{{item.dimensions_list}}" wx:for-item="dim" wx:key="name" class="bar-row">
      <view class="bar-label">
        <text>{{dim.name}}</text>
        <text>{{dim.value}}</text>
      </view>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{dim.value}}%;"></view>
      </view>
    </view>
    <view class="reason">{{item.reason || '暂无匹配理由，建议由平台人工复核。'}}</view>
    <view class="suggestion">{{item.suggestion || '建议补充成果指标、成熟度和合作方式后继续撮合。'}}</view>
    <view class="actions">
      <button class="btn primary" data-index="{{item.index}}" bindtap="chooseIntent">我想合作</button>
    </view>
  </view>
</view>
