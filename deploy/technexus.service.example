[Unit]
Description=TechNexus 技术经理人网页服务
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/technexus
Environment=TECHNEXUS_HOST=127.0.0.1
Environment=TECHNEXUS_PORT=8010
ExecStart=/opt/technexus/.venv/bin/python /opt/technexus/technexus_app/app.py --host 127.0.0.1 --port 8010 --no-browser
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
