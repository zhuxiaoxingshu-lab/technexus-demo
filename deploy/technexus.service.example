[Unit]
Description=TechNexus 技术经理人网页服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=technexus
Group=technexus
WorkingDirectory=/opt/technexus
EnvironmentFile=/etc/technexus/technexus.env
Environment=TECHNEXUS_HOST=127.0.0.1
Environment=TECHNEXUS_PORT=8010
Environment=TECHNEXUS_HTTPS_ONLY=1
Environment=TECHNEXUS_TRUST_PROXY_HEADERS=1
ExecStart=/opt/technexus/.venv/bin/python /opt/technexus/technexus_app/app.py --host 127.0.0.1 --port 8010 --no-browser
Restart=always
RestartSec=5
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/technexus/technexus_data -/opt/technexus/admin_config.json

[Install]
WantedBy=multi-user.target
